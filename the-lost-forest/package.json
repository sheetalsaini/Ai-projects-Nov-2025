{
  "name": "the-lost-forest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "server": "tsx server/index.ts",
    "test": "npm run build:server && node --import tsx --test --test-force-exit --test-timeout=25000 tests/*.test.ts",
    "start": "node build/server/index.js",
    "build:server": "tsc -p tsconfig.server.json"
  },
  "dependencies": {
    "@colyseus/sdk": "^0.17.0",
    "@colyseus/schema": "^4.0.0",
    "colyseus": "^0.17.0",
    "@colyseus/ws-transport": "^0.17.0",
    "express": "^4.21.2",
    "phaser": "^3.90.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "vite": "^7.0.0",
    "@types/pg": "^8.15.0"
  }
}